# ============================================
# FRONTEND (Vite) - copiate in .env la root
# ============================================
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3001

# ============================================
# BACKEND API (Express) - folosit de api/
# ============================================
API_PORT=3000

# CORS: origine/origini permise (separate prin virgula)
CORS_ORIGIN=http://localhost:5173

# Baza de date MySQL
DB_HOST=mysql.Proiect_An_Vue_API
DB_PORT=3306
DB_NAME=Proiect_An_Vue_API
DB_USER=Proiect_An_Vue_API
DB_PASSWORD=change-me-in-production

# JWT secret (genereaza unul lung si aleator in productie)
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRES_IN=7d

# ============================================
# WebSocket server
# ============================================
WS_PORT=3001

# ============================================
# MySQL container (compose.yaml)
# ============================================
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=Proiect_An_Vue_API
MYSQL_USER=Proiect_An_Vue_API
MYSQL_PASSWORD=change-me-in-production
